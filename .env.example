# WhatsApp Cloud API (Meta for Developers -> your app -> WhatsApp -> API Setup)
WHATSAPP_TOKEN=your-permanent-access-token
WHATSAPP_PHONE_NUMBER_ID=your-phone-number-id
WHATSAPP_VERIFY_TOKEN=choose-any-random-string-you-invent
# App secret (App settings -> Basic). Used to verify webhook signatures. Recommended in production.
WHATSAPP_APP_SECRET=your-app-secret

# Anthropic
ANTHROPIC_API_KEY=your-anthropic-api-key
ANTHROPIC_MODEL=claude-sonnet-5
AGENT_SYSTEM_PROMPT=You are a helpful assistant answering WhatsApp messages. Keep replies concise.
